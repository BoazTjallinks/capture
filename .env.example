# ==============================================
# Capture Agent Configuration
# ==============================================

# Listening port (default 59232)
PORT=59232

# Required: Bearer token Checkmate uses to call this agent.
API_SECRET=change-me

# Script Execution
# ----------------
# Disabled by default. Set to "true" to enable POST /api/v1/script.
SCRIPT_EXECUTION_ENABLED=false

# Comma-separated list of allowed runtimes. Available: bash, python, powershell.
# Default: bash
ALLOWED_SCRIPT_RUNTIMES=bash
